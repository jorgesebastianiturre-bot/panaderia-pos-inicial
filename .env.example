# ============================================================
# PANADERÍA POS — Variables de entorno
# Copiá este archivo como .env.local y completá los valores
# NUNCA subas .env.local a Git
# ============================================================

# URL de tu proyecto Supabase (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://XXXXXXXX.supabase.co

# Clave pública anon (Settings → API → anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clave de servicio — SOLO para el script de migración, NO en frontend
# (Settings → API → service_role secret)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
